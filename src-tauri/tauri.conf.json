{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SiriLoader",
  "version": "0.1.0",
  "identifier": "dev.siriphob.siriloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SiriLoader",
        "width": 960,
        "height": 640,
        "minWidth": 520,
        "minHeight": 400,
        "backgroundColor": "#FFFFFF",
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "siriloader"
        ]
      }
    }
  }
}
