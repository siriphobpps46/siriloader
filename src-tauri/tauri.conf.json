{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SiriLoader",
  "version": "0.1.0",
  "identifier": "dev.siriphob.siriloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SiriLoader",
        "width": 920,
        "height": 720,
        "minWidth": 560,
        "minHeight": 480,
        "backgroundColor": "#F5F7FB",
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
